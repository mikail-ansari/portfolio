# Copy this file to `.env` and fill in only what you need.
# Anything left empty is simply hidden on the website.

# Your public site URL, no trailing slash. Used for SEO / social-preview tags.
# Set it after you know your final domain, e.g. https://your-site.pages.dev
VITE_SITE_URL=

# Public contact email (shown on the Contact section, used as a mailto fallback)
VITE_CONTACT_EMAIL=

# Your GitHub profile URL, e.g. https://github.com/your-username
VITE_GITHUB_URL=

# Formspree form ID (free contact-form service), e.g. xyzabcde
VITE_FORMSPREE_ID=

# Only for GitHub Pages *project* sites (https://user.github.io/repo-name/):
# VITE_BASE=/repo-name/
